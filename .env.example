# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Канал для публикаций: @username или числовой ID (-100...). Бот должен быть админом канала.
CHANNEL_ID=@my_land_channel

# Ваш Telegram ID (узнать: @userinfobot) — для команд, модерации и уведомлений об ошибках
ADMIN_ID=123456789

# Время публикаций (через запятую) и часовой пояс
POST_TIMES=10:00
TIMEZONE=Europe/Moscow

# 1 = каждый пост сначала приходит вам с кнопками «Опубликовать / Другая / Отклонить»
# 0 = публикуется сразу
MODERATION=0

# Насколько свежие новости брать (часы)
LOOKBACK_HOURS=48

# Подпись в конце каждого поста (можно оставить пустой)
SIGNATURE=

# ── Нейросеть, которая пересказывает новости (оставьте раскомментированным ОДИН вариант) ──

# Вариант 1 (бесплатно): Ollama — нейросеть работает на вашем же сервере, без ключей и оплаты.
# Нужно ~8 ГБ оперативной памяти. Установка: curl -fsSL https://ollama.com/install.sh | sh
# затем: ollama pull qwen3:8b
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434

# Вариант 2 (бесплатно): Google Gemini, бесплатный тариф. Ключ: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=ваш_ключ_gemini
# LLM_MODEL=gemini-3.5-flash-lite

# Вариант 3 (бесплатно): OpenRouter, модели с суффиксом :free. Ключ: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENAI_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3-235b-a22b:free

# Вариант 4 (платно, лучшее качество): Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
